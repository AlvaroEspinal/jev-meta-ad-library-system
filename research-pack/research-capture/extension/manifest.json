{
  "manifest_version": 3,
  "name": "Research Capture \u2014 Local Evidence",
  "version": "0.2.1",
  "description": "Explicit Quick Download and Save to Obsidian. No ambient capture. Instagram external imports only.",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Capture research evidence"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; img-src 'self' data:; style-src 'self'"
  },
  "version_name": "0.2.1 friend distribution (capture base 0.2.0)"
}
